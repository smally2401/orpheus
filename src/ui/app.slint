import { Button, ListView } from "std-widgets.slint";
import { SlintAlbum, SlintSong } from "types.slint";
import { AlbumView } from "album_view.slint";
import { LibraryView } from "library_view.slint";
import { NowPlayingBar } from "now_playing_bar.slint";

enum View { Library, Album }

export component AppWindow inherits Window {
    title: "orpheus";
    maximized: true;
    background: #1e1e2e;

    in property <[SlintAlbum]> albums: [];
    in-out property <View> current-view: View.Library;
    in-out property <SlintAlbum> viewing-album;
    in-out property <int> viewing-album-index;

    in property <string> current-track-title: "No song playing";
    in property <string> current-artist: "---";
    in property <int> current-position: 0;
    in property <int> total-duration: 0;

    callback play-paused-clicked();
    callback next-track-clicked();
    callback prev-track-clicked();

    callback play-album-clicked();
    callback play-track-clicked(int);

    callback seek-requested(int);
    callback volume-changed(float);

    VerticalLayout {
        padding: 20px;
        spacing: 15px;
        alignment: center;

        if root.current-view == View.Album:
            AlbumView {
                album: root.viewing-album;
                back-clicked => { root.current-view = View.Library }
                play-album-clicked => { root.play-album-clicked() }
                play-track-clicked(idx) => { root.play-track-clicked(idx) }
            }
        
        if root.current-view == View.Library: 
            LibraryView {
                albums: root.albums;
                album-opened(i) => {
                    root.current-view = View.Album;
                    root.viewing-album = root.albums[i];
                    root.viewing-album-index = i;
                }
            }

        NowPlayingBar {
            play-paused-clicked => { root.play-paused-clicked() }
            next-track-clicked => { root.next-track-clicked() }
            prev-track-clicked => { root.prev-track-clicked() }
            current-position: root.current-position;
            total-duration: root.total-duration;
            seek-requested(val) => { root.seek-requested(val) }
            current-track-title: root.current-track-title;
            current-artist: root.current-artist;
        }
    }
}
