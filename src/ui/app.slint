import { Button, Slider, ListView } from "std-widgets.slint";
import { SlintAlbum, SlintSong } from "types.slint";

export component AppWindow inherits Window {
    title: "orpheus";
    width: 400px;
    height: 500px;
    background: #1e1e2e;

    in property <[SlintAlbum]> albums: [];
    in-out property <bool> show-library: true;

    in property <string> current-track-title: "No song playing";
    in property <string> current-artist: "---";

    callback play-paused-clicked();
    callback next-track-clicked();
    callback prev-track-clicked();

    callback album-selected(int);

    VerticalLayout {
        padding: 20px;
        spacing: 15px;
        alignment: center;

        Text {
            text: root.current-track-title;
            color: #cdd6f4;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Text {
            text: root.current-artist;
            color: #cdd6f4;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Slider {
            minimum: 0;
            maximum: 100;
            value: 30;
        }

        Button {
            text: "play/pause";
            clicked => {
                root.play-paused-clicked();
            }
        }

        Button {
            text: "next track";
            clicked => {
                root.next-track-clicked();
            }
        }

        Button {
            text: "previous track";
            clicked => {
                root.prev-track-clicked();
            }
        }

        if !root.show-library:
            Button {
                text: "back to library";
                clicked => {
                    root.show-library = true;
                }
            }
        
        if root.show-library: 
            ListView {
                height: 200px;
                for entry[i] in root.albums: TouchArea {
                    height: 65px;
                    Rectangle { VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        Text { text: entry.title; font-size: 15px; }
                        Text { text: entry.artist; font-size: 12px; }
                    } }
                    clicked => {
                        root.album-selected(i);
                        root.show-library = false;
                    }
                }
            }
    }
}
