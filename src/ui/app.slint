import { Button, ListView } from "std-widgets.slint";
import { SlintAlbum, SlintSong, SlintPlaylist } from "types.slint";
import { AlbumView } from "views/album_view.slint";
import { LibraryView } from "views/library_view.slint";
import { NowPlayingBar } from "now_playing/now_playing_bar.slint";
import { Sidebar } from "sidebar.slint";
import { PlaylistsView } from "views/playlists_view.slint";
import { OpenPlaylistView } from "views/open_playlist_view.slint";

import "../../assets/fonts/NotoSans-Regular.ttf";

enum View { Library, Album, Playlists, OpenPlaylist }

export component AppWindow inherits Window {
    title: "orpheus";
    maximized: true;
    background: #1e1e2e;
    default-font-family: "Noto Sans";

    in property <[SlintAlbum]> albums: [];
    in-out property <View> current-view: View.Library;
    in-out property <SlintAlbum> viewing-album;
    in-out property <int> viewing-album-index;

    in property <string> current-track-title: "No song playing";
    in property <string> current-artist: "---";
    in property <image> current-art;
    in property <int> current-position: 0;
    in property <int> total-duration: 0;

    in property <[SlintPlaylist]> playlists: [];
    in-out property <SlintPlaylist> viewing-playlist;
    in-out property <int> viewing-playlist-index;

    callback play-paused-clicked();
    callback next-track-clicked();
    callback prev-track-clicked();

    callback play-album-clicked();
    callback play-track-clicked(int);

    callback play-playlist-clicked();
    callback play-playlist-track-clicked(int);

    callback seek-requested(int);
    callback volume-changed(float);

    // LUA CONFIG
    in property <color> sidebar-bg;
    in property <color> now-playing-bg;
    in property <color> library-view-bg;
    in property <color> album-view-bg;
    in property <color> playlists-view-bg;
    in property <color> open-playlist-view-bg;

    VerticalLayout {

        HorizontalLayout {
            vertical-stretch: 1;

            Sidebar {
                library-selected => { root.current-view = View.Library }
                playlists-selected => { root.current-view = View.Playlists }
                bg-color: root.sidebar-bg;
            }

            VerticalLayout {

                if root.current-view == View.Album:
                    AlbumView {
                        album: root.viewing-album;
                        bg-color: root.album-view-bg;
                        play-album-clicked => { root.play-album-clicked() }
                        play-track-clicked(idx) => { root.play-track-clicked(idx) }
                    }
                
                if root.current-view == View.Library: 
                    LibraryView {
                        albums: root.albums;
                        bg-color: root.library-view-bg;
                        album-opened(i) => {
                            root.current-view = View.Album;
                            root.viewing-album = root.albums[i];
                            root.viewing-album-index = i;
                        }
                    }

                if root.current-view == View.OpenPlaylist:
                    OpenPlaylistView {
                        bg-color: root.open-playlist-view-bg;
                        playlist: root.viewing-playlist;
                        play-playlist-clicked => { root.play-playlist-clicked() }
                        play-playlist-track-clicked(idx) => { root.play-playlist-track-clicked(idx) }
                    }

                if root.current-view == View.Playlists:
                    PlaylistsView {
                        bg-color: root.playlists-view-bg;
                        playlists: root.playlists;
                        playlist-opened(i) => {
                            root.current-view = View.OpenPlaylist;
                            root.viewing-playlist = root.playlists[i];
                            root.viewing-playlist-index = i;
                        }
                    }
            }
        }

        NowPlayingBar {
            play-paused-clicked => { root.play-paused-clicked() }
            next-track-clicked => { root.next-track-clicked() }
            prev-track-clicked => { root.prev-track-clicked() }
            current-position: root.current-position;
            total-duration: root.total-duration;
            seek-requested(val) => { root.seek-requested(val) }
            current-track-title: root.current-track-title;
            current-artist: root.current-artist;
            volume-changed(vol) => { root.volume-changed(vol) }
            current-art: root.current-art;
            bg-color: root.now-playing-bg;
        }
    }
}
