import { SlintPlaylist } from "../types.slint";
import { Button, ListView, StandardButton } from "std-widgets.slint";
import { DetailViewHeader } from "detail_view_header.slint";

export component OpenPlaylistView {
    in property <SlintPlaylist> playlist;
    in property <color> bg-color;

    callback play-playlist-clicked;
    callback play-playlist-track-clicked(int);

    Rectangle {
        background: root.bg-color;
        VerticalLayout {
            padding: 20px;
            spacing: 10px;

            DetailViewHeader {
                art: @image-url("../../../assets/images/cover_placeholder.png");
                title: root.playlist.name;
                subtitle: "TRACK_COUNT tracks";
                play-clicked => { root.play-playlist-clicked() }
            }

            // todo: add album art for each track
            ListView {
                for entry[i] in root.playlist.tracks: TouchArea {
                    height : 65px;
                    Rectangle {
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: entry.art;
                                    width: 40px;
                                    height: 40px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: entry.title;
                                    font-size: 15px;
                                }
                                Text {
                                    text: entry.artist;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                    clicked => {
                        root.play-playlist-track-clicked(i);
                    }
                }
            }
        }
    }
}
