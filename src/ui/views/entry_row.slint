export component EntryRow {
    in property <image> thumbnail;
    in property <string> title;
    in property <string> subtitle;

    in property <color> library-list-title-text-color;
    in property <color> library-list-subtitle-text-color;
    in property <int> library-list-title-text-size;
    in property <int> library-list-subtitle-text-size;

    callback entry-clicked();

    height: 65px;

    TouchArea {
        Rectangle {
            HorizontalLayout {
                padding-left: 20px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.thumbnail;
                        width: 40px;
                        height: 40px;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: root.title;
                        font-size: library-list-title-text-size * 1px;
                        color: root.library-list-title-text-color;
                    }
                    Text {
                        text: root.subtitle;
                        font-size: library-list-subtitle-text-size * 1px;
                        color: root.library-list-subtitle-text-color;
                    }
                }
            }
        }
        clicked => { entry-clicked() }
    }
}
