export struct SlintSong {
    title: string,
    artist: string,
}

export struct SlintSongWithArt {
    title: string,
    artist: string,
    art: image,
}

export struct SlintAlbum {
    title: string,
    artist: string,
    track_count: int,
    tracks: [SlintSong],
    art: image,
}

export struct SlintPlaylist {
    name: string,
    track_count: int,
    tracks: [SlintSongWithArt],
}
